# API the app talks to. Defaults to the production API when unset.
# For a local backend use your computer's LAN address (a phone cannot reach "localhost"), e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:5280/api/v1
# Release builds refuse anything that is not https://.
EXPO_PUBLIC_API_URL=https://familyshop-production.up.railway.app/api/v1
