# API the app talks to. When unset the app uses the PRODUCTION API, and the Expo web preview
# (http://localhost:8081) is then blocked by CORS ("Не удалось загрузить категории").
# Local backend (web preview, iOS simulator):
EXPO_PUBLIC_API_URL=http://localhost:5280/api/v1
# A phone cannot reach "localhost" - use your computer's LAN address instead:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:5280/api/v1
# Production (release builds refuse anything that is not https://). This is also the built-in default when the variable is unset:
# EXPO_PUBLIC_API_URL=https://api.familyshop10.kz/api/v1
