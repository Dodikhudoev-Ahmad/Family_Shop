#!/bin/bash
# Хук pre-commit: не даёт закоммитить секреты. Включается командой: git config core.hooksPath .githooks

# Список проверяемых шаблонов (регулярные выражения для grep -E, регистр не важен)
PATTERNS=(
  # Пароль в строке подключения или в коде: слово password или pwd, знак равно, значение
  '(password|pwd)[[:space:]]*=[[:space:]]*[^[:space:];"'"'"'{$]{3,}'
  # Ключ подписи JWT со значением: secretkey, знак равно или двоеточие, значение
  'secret_?key["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9+/_.=-]{8,}'
  # Ключ API со значением: api_key или api-key, знак равно или двоеточие, значение
  'api[_-]?key["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9+/_.=-]{8,}'
  # Токен со значением в кавычках (просто слово token в коде не считается)
  'token["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9+/_.=-]{16,}["'"'"']'
  # Строка подключения postgresql:// или postgres:// с логином и паролем
  'postgres(ql)?://[^:/@[:space:]]+:[^@[:space:]]+@'
  # Приватный ключ в формате PEM
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  # Ключ в формате sk-... (OpenAI, Anthropic и похожие): не внутри слова, чтобы task-/risk- не срабатывали
  '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}'
  # JWT: заголовок eyJ... (base64 от {"), затем ещё длинный фрагмент
  'eyJ[A-Za-z0-9_-]{15,}'
)

# Слова-признаки явного плейсхолдера: такие строки пропускаем
ALLOW='(CHANGE_ME|example|placeholder|your[_-]?(key|password|secret)|<[a-z_ -]+>)'

# Файлы, которые не проверяем: сам хук, lock-файлы, картинки, снимки, служебные файлы EF (там длинные хеши, это не секреты)
SKIP='(^\.githooks/|package-lock\.json$|\.lock$|\.svg$|\.png$|\.jpe?g$|\.webp$|\.snap$|Designer\.cs$|ModelSnapshot\.cs$)'

# Длинная случайная строка (40+ символов подряд из букв, цифр и + = _ -) проверяется отдельно: идентификаторы кода и
# имена файлов на неё не похожи и пропускаются. Возвращает 0, если строка выглядит как идентификатор/имя, а не секрет.
looks_like_name() {
  local c="$1" len=${#1} digits upper lower
  digits=$(echo -n "$c" | tr -cd '0-9' | wc -c | tr -d ' ')
  upper=$(echo -n "$c" | tr -cd 'A-Z' | wc -c | tr -d ' ')
  lower=$(echo -n "$c" | tr -cd 'a-z' | wc -c | tr -d ' ')
  # Идентификатор C#/TS: начинается с буквы, только буквы, цифры и _, цифр немного
  if [[ "$c" =~ ^[A-Za-z][A-Za-z0-9_]*$ && "$digits" -le 3 ]]; then
    # КОНСТАНТА_ЗАГЛАВНЫМИ или слова в CamelCase (заглавных не больше четверти); случайная смесь регистров даёт ~40% заглавных
    if [ "$lower" -eq 0 ] || [ $((upper * 4)) -le "$len" ]; then return 0; fi
  fi
  # Имя файла через дефисы: строчные буквы, цифры (дата в начале), минимум один дефис, цифр немного
  if [[ "$c" =~ ^[a-z0-9][a-z0-9]*(-[a-z0-9]+)+$ && "$digits" -le 8 ]]; then return 0; fi
  return 1
}

# Число добавленных строк (без плейсхолдеров), где есть 40+ символов подряд, не похожих на идентификатор или имя файла
count_long_random() {
  local n=0 line cand bad
  while IFS= read -r line; do
    line="${line#+}" # убираем плюс — маркер добавленной строки в diff
    [ -z "$line" ] && continue
    echo "$line" | grep -qiE -- "$ALLOW" && continue
    bad=0
    while IFS= read -r cand; do
      [ -z "$cand" ] && continue
      looks_like_name "$cand" || bad=1
    done < <(echo "$line" | grep -oE '[A-Za-z0-9+=_-]{40,}')
    n=$((n + bad))
  done <<< "$1"
  echo "$n"
}

# Счётчик найденных проблем
FOUND=0

# Идём по каждому добавленному или изменённому файлу из индекса
for FILE in $(git diff --cached --name-only --diff-filter=AM | grep -vE "$SKIP"); do
  # Берём только добавляемые строки этого файла (с плюсом в начале), без служебной строки «+++»
  ADDED=$(git diff --cached --no-color -U0 -- "$FILE" | grep -E '^\+' | grep -vE '^\+\+\+')
  # Идём по каждому шаблону
  for P in "${PATTERNS[@]}"; do
    # Считаем строки, подходящие под шаблон, не считая строк с плейсхолдерами
    N=$(echo "$ADDED" | grep -iE -- "$P" | grep -viEc -- "$ALLOW")
    # Если что-то нашли
    if [ "$N" -gt 0 ]; then
      # Печатаем только путь и число строк (сами строки не печатаем, чтобы секрет не попал в терминал)
      echo "СЕКРЕТ? $FILE: совпадений $N, шаблон: $P" >&2
      # Увеличиваем счётчик
      FOUND=$((FOUND + 1))
    fi
  done
  # Длинная случайная строка
  N=$(count_long_random "$ADDED")
  if [ "$N" -gt 0 ]; then
    echo "СЕКРЕТ? $FILE: совпадений $N, шаблон: длинная случайная строка (40+ символов, не идентификатор)" >&2
    FOUND=$((FOUND + 1))
  fi
done

# Если что-то нашли, блокируем коммит
if [ "$FOUND" -gt 0 ]; then
  # Объясняем, что делать дальше
  echo "Коммит остановлен. Убери секрет (используй user-secrets или переменные окружения)." >&2
  # Подсказка про ложное срабатывание
  echo "Если это тестовое значение, замени его на явный плейсхолдер (CHANGE_ME, example) и повтори." >&2
  # Код 1 означает «остановить коммит»
  exit 1
fi

# Всё чисто: разрешаем коммит
exit 0
