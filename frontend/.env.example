# API the site talks to (build-time). Local development:
VITE_API_URL=http://localhost:5280/api/v1
# Production (set in the hosting environment, then rebuild):
# VITE_API_URL=https://api.familyshop10.kz/api/v1
# The earlier name VITE_API_BASE_URL still works when VITE_API_URL is not set.
# Production: https://www.familyshop10.kz (no trailing slash; familyshop10.kz redirects to www at the registrar).
# Drives canonical/og:url/og:image in index.html and src/data/seo.ts.
VITE_SITE_URL=https://www.familyshop10.kz

# Shop contacts shown in the footer / About page. Leave unset to hide (never ship placeholders).
# VITE_CONTACT_PHONE is the display string, e.g. "+7 700 000 00 00" - the footer derives the
# tel: link from it automatically. VITE_SOCIAL_* are full https:// URLs.
# VITE_CONTACT_PHONE=
# VITE_CONTACT_EMAIL=
# VITE_CONTACT_ADDRESS=
# VITE_SOCIAL_INSTAGRAM=
# VITE_SOCIAL_TELEGRAM=
# VITE_SOCIAL_VK=
# VITE_SOCIAL_WHATSAPP=
